{
  "name": "cv-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js --external:mysql2 --external:@hono/node-server --sourcemap",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "typecheck": "tsc --noEmit",
    "selfcheck": "esbuild src/template/selfcheck-cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/selfcheck.js && node dist/selfcheck.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.2",
    "jose": "^6.0.8",
    "mysql2": "^3.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
