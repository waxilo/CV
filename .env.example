# 数据库连接：复用 ../mysql-server 容器（compose 网络内的服务名是 mysql）
# 真实值由 scripts/db-init.sh 生成到 .env，这个文件只说明有哪些项。
DB_HOST=mysql
DB_PORT=3306
DB_NAME=cv_builder
DB_USER=cv_builder
DB_PASSWORD=

# 登录令牌签名密钥；轮换会让所有已登录会话失效（重新登录即可）。
JWT_SECRET=
JWT_EXPIRES_IN=7d

# API Key（cvk_...）密文的加密密钥；轮换时把旧值填进 *_PREVIOUS，
# 让旧 Key 仍能被解出来，之后取回一次即自动用新密钥重加密。
API_KEY_ENCRYPTION_SECRET=
API_KEY_ENCRYPTION_SECRET_PREVIOUS=

# 本机直连调试用的发布端口（127.0.0.1:${APP_PORT} → 容器 8787）。
# 端口占用：8787 writing-assistant、8788 notify-hub、8789 cred-broker。
# 公网域名不经过这里，由共享网关 ../gw 直接打 cv:8787。
APP_BIND_ADDR=127.0.0.1
APP_PORT=8790
